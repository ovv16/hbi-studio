# Cloudflare Pages headers, served with the static files in this directory.
#
# Rules are additive: a request matching several patterns receives every
# matching header, and a header set twice is joined with a comma. So the
# security headers live on one catch-all, and each Cache-Control pattern is
# written not to overlap another. Responses from /functions (the /api/lead
# endpoint) are not covered by this file; that function sets its own headers.
#
# No Content-Security-Policy is enforced yet: the page carries inline scripts
# and styles. A Report-Only proposal is in DEPLOYMENT.md.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN

# HTML: always revalidate so a deploy is seen at once.
/
  Cache-Control: public, max-age=0, must-revalidate
/privacy
  Cache-Control: public, max-age=0, must-revalidate
/terms
  Cache-Control: public, max-age=0, must-revalidate
/404.html
  Cache-Control: public, max-age=0, must-revalidate

# style.css, main.js and legal.css are referenced with a ?v= version that is
# bumped on every change; that bump is what refreshes them, so a day at the
# edge is safe.
/style.css
  Cache-Control: public, max-age=86400
/main.js
  Cache-Control: public, max-age=86400
/legal.css
  Cache-Control: public, max-age=86400

# Fonts never change under the same file name.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Result photographs are always referenced with ?v=, and a regenerated file
# always ships with a new version, so the versioned URL is immutable.
/assets/results/*
  Cache-Control: public, max-age=31536000, immutable

# These keep their file names when replaced: a week, not a year.
/assets/services/*
  Cache-Control: public, max-age=604800
/assets/og/*
  Cache-Control: public, max-age=604800
/assets/:file
  Cache-Control: public, max-age=604800
/logo/:file
  Cache-Control: public, max-age=604800
