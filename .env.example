# Cloudflare Pages → Settings → Environment variables (Production and Preview).
# Placeholders only. Never commit real values. Local dev with wrangler reads
# the same names from a .dev.vars file, which is gitignored.

# Bot token from @BotFather. DO NOT USE THE OLD EXPOSED TOKEN — revoke it and
# paste the new one into Cloudflare, not here.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat ids that should receive leads, e.g. 111,222
TELEGRAM_CHAT_IDS=
